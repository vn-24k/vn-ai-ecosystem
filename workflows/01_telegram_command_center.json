{
  "name": "01 - Telegram Executive Command Center",
  "nodes": [
    {
      "parameters": {
        "updates": ["message", "callback_query"]
      },
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Telegram Command Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const update = $json;\nconst msg = update.message || {};\nconst callback = update.callback_query || {};\n\nconst userId = msg.from?.id || callback.from?.id;\nconst text = (msg.text || callback.data || '').trim();\nconst isAuthorized = String(userId) === '2140439370';\n\nlet intent = 'UNKNOWN';\nif (text.startsWith('/start') || text.startsWith('/menu')) intent = 'MENU';\nelse if (text.startsWith('/software') || text.includes('build_software')) intent = 'SOFTWARE_FACTORY';\nelse if (text.startsWith('/media') || text.includes('gen_media')) intent = 'MEDIA_STUDIO';\nelse if (text.startsWith('/dissecar') || text.includes('dissect_yt')) intent = 'DISSECT_YOUTUBE';\nelse if (text.startsWith('/status')) intent = 'SYSTEM_STATUS';\n\nreturn [{\n  json: {\n    userId,\n    isAuthorized,\n    text,\n    intent,\n    chatId: '2140439370'\n  }\n}];"
      },
      "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
      "name": "Classify Command & Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.intent }}",
        "rules": {
          "rules": [
            {
              "value2": "MENU"
            },
